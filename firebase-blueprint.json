{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "balance": { "type": "number", "description": "Current balance in BRL" },
        "bonusBalance": { "type": "number", "description": "Current bonus balance" },
        "bonusRolloverTarget": { "type": "number", "description": "Required wagering total for bonus" },
        "bonusRolloverProgress": { "type": "number", "description": "Current wagering progress for bonus" },
        "referralBalance": { "type": "number", "description": "Earnings from referrals ready to be claimed" },
        "vipLevel": { "type": "number", "description": "Account VIP level" },
        "lastIp": { "type": "string", "description": "Last known IP address" },
        "referralCode": { "type": "string", "description": "Unique code for referrals" },
        "referredBy": { "type": "string", "description": "UID of the referring user" },
        "referralCount": { "type": "number", "description": "Total users referred" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "balance", "referralCode", "createdAt", "updatedAt"]
    },
    "IpLog": {
      "title": "IP Access Log",
      "description": "Log of IP addresses used by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "ip", "timestamp"]
    },
    "Withdrawal": {
      "title": "Withdrawal Request",
      "description": "Request for balance withdrawal",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "amount": { "type": "number" },
        "cpf": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "amount", "cpf", "status", "createdAt", "updatedAt"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "App-wide configuration",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "announcement": { "type": "string" },
        "showAnnouncement": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User private profile"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Pending and processed withdrawal requests"
    },
    "/settings/global": {
      "schema": "GlobalSettings",
      "description": "Application-wide settings like maintenance mode and announcements"
    },
    "/ip_logs/{logId}": {
      "schema": "IpLog",
      "description": "Security logs for IP tracking"
    }
  }
}
